# ---------------------------------------------------------------------------
# Experiment artefacts (reports, checkpoints, logs, plots)
# ---------------------------------------------------------------------------
/reports/
/ray_results/
/presentation/
/runs/
experiments/**/reports/
*.csv
*.onnx
*.pkl
*.pt
*.pth
*.ckpt
*.npz
*.png
*.jpg
*.pgf
# documentation images are exempt from the global image ignore
!docs/images/**/*.png
!docs/images/**/*.jpg
pylint.html

# Downloaded datasets (top level only; ``src/cjd_flows/data`` is source code!)
/data/
/downloads/

# Local configuration
config_local.json
config_local.yml
/temp/
.env
.idea/
.vscode/
.DS_Store

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build
/build/
/dist/
/wheels/
*.egg-info/
*.egg
.eggs/
MANIFEST

# Virtual environments (uv creates .venv)
.venv/
venv/
env/
ENV/

# Test / coverage / type-checker / linter caches
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
*.log

# Documentation builds
docs/_build/
/site/

# Jupyter
.ipynb_checkpoints/
profile_default/
ipython_config.py
